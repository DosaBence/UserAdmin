<Page x:Class="UserAdmin.Views.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UserAdmin.Views"
      mc:Ignorable="d"
      Title="Regisztráció"
      Background="{StaticResource AccentBrush}">

    <Grid>
        <Border Style="{StaticResource CardBorder}" Width="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Fiók létrehozása" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>
                <TextBlock Text="Add meg az adataidat a regisztrációhoz!" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <TextBlock Text="Felhasználónév" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox"/>
            </StackPanel>
            
        </Border>
    </Grid>
</Page>
